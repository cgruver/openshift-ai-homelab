{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": "allow",
    "external_directory": {
      "*": "ask",
      "/projects/*": "allow"
    }
  },
  "mcp": {
    "docs-mcp-server": {
      "type": "remote",
      "url": "https://docs-mcp-server-docs-mcp-server.apps.clg-lab.clg.lab/mcp"
    }
  },
  "enabled_providers": [
    "asus-gx10"
  ],
  "provider": {
    "asus-gx10": {
      "name": "ASUS GX 10",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://10.11.12.101:8080/v1"
      },
      "models": {
        "nemotron-3-super": {
          "name": "nemotron-3-super",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "reasoning": true
        },
        "laguna-S-2.1": {
          "name": "laguna-S-2.1",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "reasoning": true
        }
      }
    }
  },
  "model": "laguna-S-2.1",
  "agent": {
    "plan": {
      "options": {},
      "permission": {}
    },
    "debug": {
      "options": {},
      "permission": {}
    },
    "orchestrator": {
      "options": {},
      "permission": {}
    },
    "ask": {
      "options": {},
      "permission": {}
    },
    "code": {
      "options": {},
      "permission": {}
    }
  },
  "auto_collapse_reasoning": false,
  "terminal_command_display": "expanded"
}